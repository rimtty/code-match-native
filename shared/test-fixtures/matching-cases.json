{
  "schemaVersion": 1,
  "notes": [
    "label-NN cases come from the 12 field label pairs documented in the customer spec (docs/qr-barcode-spec-analysis.html, git-ignored).",
    "The first 22 QR characters (card number | item number | suffix) of every label-NN case are the real decoded values.",
    "Only label-01 and label-09 carry the real full 66-character QR record. The remaining ten reuse a synthetic tail (quantities, factory, warehouse, supply point) so the record stays 66 characters; replace the tail with the real decode when the label photos are re-read.",
    "label-AA-qr-vs-label-BB-tag cases pair a QR with the tag of the neighbouring label of the same series (e.g. 52 vs 55) to pin the most likely field mix-up as a mismatch."
  ],
  "cases": [
    {
      "id": "standard-match",
      "qrPayload": "DCLP675300BCJH5281GG020000120000001200L000000000000BLBDILLU92   0*",
      "barcodePayload": "BCJH-52-81GG@1N5X0C",
      "expected": "match"
    },
    {
      "id": "different-part-number",
      "qrPayload": "DCLP675300BCJH5281GG020000120000001200L000000000000BLBDILLU92   0*",
      "barcodePayload": "BCJH-55-81GG@1KVV0C",
      "expected": "mismatch"
    },
    {
      "id": "management-code-is-ignored",
      "qrPayload": "DCLP675300BCJH5281GG020000120000001200L000000000000BLBDILLU92   0*",
      "barcodePayload": "BCJH-52-81GG@ZZZZZZ",
      "expected": "match"
    },
    {
      "id": "non-standard-qr-containment",
      "qrPayload": "PART:BCJH-52-81GG;QTY:12",
      "barcodePayload": "BCJH-52-81GG@1N5X0C",
      "expected": "match"
    },
    {
      "id": "empty-values",
      "qrPayload": "",
      "barcodePayload": "",
      "expected": "mismatch"
    },
    {

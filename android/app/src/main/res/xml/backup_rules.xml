<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Code Match history, settings, and scanner recovery state are
        device-local. Keep the root exclusions even when adding a new
        persistence implementation: Android 12+ OEMs may still run
        device-to-device transfer when android:allowBackup is false.
    -->
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore/" />
    <!-- DataStore name: codematch-ble-symbology.preferences_pb. Keep the
         scanner recovery snapshot local to this physical device. -->
    <exclude domain="file" path="datastore/codematch-ble-symbology.preferences_pb" />
    <!-- Reserved for any future non-DataStore BLE state. -->
    <exclude domain="file" path="ble/" />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />

    <!-- Also cover device-protected storage if a future adapter uses it. -->
    <exclude domain="device_root" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
